MAVLINK_CONNECTION=/dev/ttyUSB0
MAVLINK_BAUD=57600
MAVLINK_TARGET_SYSID=1
MAVLINK_SOURCE_SYSTEM=254
MAVLINK_SOURCE_COMPONENT=191
HEARTBEAT_TIMEOUT=10
BACKEND_URL=http://workstation-ip:5000
API_KEY=replace-with-the-same-long-random-secret-key
AIRCRAFT_ID=1
HTTP_TIMEOUT=15
DATA_DIR=./data
KEEP_LOCAL_LOGS=false
TELEMETRY_HZ=2
TELEMETRY_BATCH_SECONDS=5
TELEMETRY_BATCH_MAX=500
MISSION_SYNC_INTERVAL=20
RESYNC_ON_ARM=true
POST_DISARM_DELAY=10
MIN_LOG_BYTES=4096
LOG_MAX_ATTEMPTS=10
